\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Leave-one-family-out (LOFO) robustness on MMLU. Removing non-dominant families ($\leq $15\% of their cohort) changes C\% by at most 2.93\,pp. Larger shifts from removing Mistral or Llama-3 reflect both their outsized cohort share ($>$39\%) and reduced MH statistical power from smaller remaining samples. Stratification uses total test score for computational efficiency; cross-subject matching yields identical baseline C\%.}}{13}{table.caption.31}\protected@file@percent }
\newlabel{tab:lofo}{{6}{13}{Leave-one-family-out (LOFO) robustness on MMLU. Removing non-dominant families ($\leq $15\% of their cohort) changes C\% by at most 2.93\,pp. Larger shifts from removing Mistral or Llama-3 reflect both their outsized cohort share ($>$39\%) and reduced MH statistical power from smaller remaining samples. Stratification uses total test score for computational efficiency; cross-subject matching yields identical baseline C\%}{table.caption.31}{}}
