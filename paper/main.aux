\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Cross-benchmark comparison of DIF analysis on MMLU and GSM8K. Both benchmarks exhibit temporal measurement instability with validated semi-synthetic detection power. Standard and external matching use different exploitation rates ($p$) because each benchmark's optimal operating point differs; external matching results are compared at $p = 0.5$ for both. Subscript $\pm $ values denote standard deviations across 5 random injection seeds.}}{14}{table.caption.32}\protected@file@percent }
\newlabel{tab:gsm8k_comparison}{{7}{14}{Cross-benchmark comparison of DIF analysis on MMLU and GSM8K. Both benchmarks exhibit temporal measurement instability with validated semi-synthetic detection power. Standard and external matching use different exploitation rates ($p$) because each benchmark's optimal operating point differs; external matching results are compared at $p = 0.5$ for both. Subscript $\pm $ values denote standard deviations across 5 random injection seeds}{table.caption.32}{}}
\newlabel{tab:gsm8k_comparison@cref}{{[table][7][]7}{[1][13][]14}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Cross-subject vs.\ within-subject matching for semi-synthetic DIF detection. Cross-subject matching eliminates FPR inflation ($\Delta \mathrm  {FPR} = 0.000$) while preserving detection power ($\Delta \mathrm  {TPR} > 0.3$ for 4/5 subjects at $p = 0.5$). Within-subject matching inflates FPR by ${+}0.186$ on average.}}{14}{figure.caption.33}\protected@file@percent }
\newlabel{app:fig_matching}{{3}{14}{Cross-subject vs.\ within-subject matching for semi-synthetic DIF detection. Cross-subject matching eliminates FPR inflation ($\Delta \mathrm {FPR} = 0.000$) while preserving detection power ($\Delta \mathrm {TPR} > 0.3$ for 4/5 subjects at $p = 0.5$). Within-subject matching inflates FPR by ${+}0.186$ on average}{figure.caption.33}{}}
\newlabel{app:fig_matching@cref}{{[figure][3][]3}{[1][13][]14}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Downstream impact of DIF-based item filtering on model rankings. Despite $\rho \approx 0.997$ overall, individual model families show systematic rank shifts when evaluated on stable items only.}}{14}{figure.caption.34}\protected@file@percent }
\newlabel{app:fig_downstream}{{4}{14}{Downstream impact of DIF-based item filtering on model rankings. Despite $\rho \approx 0.997$ overall, individual model families show systematic rank shifts when evaluated on stable items only}{figure.caption.34}{}}
\newlabel{app:fig_downstream@cref}{{[figure][4][]4}{[1][13][]14}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces GSM1K contamination gap vs.\ DIF ranking advantage ($N = 33$). The negative correlation ($r = -0.478$, $p = 0.005$) indicates that models with larger contamination gaps benefit less from DIF-flagged items.}}{14}{figure.caption.35}\protected@file@percent }
\newlabel{app:fig_gsm1k}{{5}{14}{GSM1K contamination gap vs.\ DIF ranking advantage ($N = 33$). The negative correlation ($r = -0.478$, $p = 0.005$) indicates that models with larger contamination gaps benefit less from DIF-flagged items}{figure.caption.35}{}}
\newlabel{app:fig_gsm1k@cref}{{[figure][5][]5}{[1][13][]14}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Ranking degradation under DIF-ordered vs.\ random item removal across six benchmarks. DIF-ordered removal (orange) consistently degrades $\rho $ faster than random removal (blue band = mean $\pm $ 1 SD, 20 seeds). Vertical dashed lines mark the Monitor/Flag (15\%) and Flag/Act (25\%) thresholds from \Cref  {sec:disc_protocol}.}}{15}{figure.caption.36}\protected@file@percent }
\newlabel{app:fig_rho_degradation}{{6}{15}{Ranking degradation under DIF-ordered vs.\ random item removal across six benchmarks. DIF-ordered removal (orange) consistently degrades $\rho $ faster than random removal (blue band = mean $\pm $ 1 SD, 20 seeds). Vertical dashed lines mark the Monitor/Flag (15\%) and Flag/Act (25\%) thresholds from \Cref {sec:disc_protocol}}{figure.caption.36}{}}
\newlabel{app:fig_rho_degradation@cref}{{[figure][6][]6}{[1][13][]15}{}{}{}}
