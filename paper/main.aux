\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Cross-subject vs.\ within-subject matching for semi-synthetic DIF detection. Cross-subject matching eliminates FPR inflation ($\Delta \mathrm  {FPR} = 0.000$) while preserving detection power ($\Delta \mathrm  {TPR} > 0.3$ for 4/5 subjects at $p = 0.5$). Within-subject matching inflates FPR by ${+}0.186$ on average.}}{11}{figure.caption.23}\protected@file@percent }
\newlabel{fig:within_subject}{{3}{11}{Cross-subject vs.\ within-subject matching for semi-synthetic DIF detection. Cross-subject matching eliminates FPR inflation ($\Delta \mathrm {FPR} = 0.000$) while preserving detection power ($\Delta \mathrm {TPR} > 0.3$ for 4/5 subjects at $p = 0.5$). Within-subject matching inflates FPR by ${+}0.186$ on average}{figure.caption.23}{}}
\newlabel{fig:within_subject@cref}{{[figure][3][]3}{[1][9][]11}{}{}{}}
