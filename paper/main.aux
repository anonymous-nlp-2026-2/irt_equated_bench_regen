\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Global vs.\ differential contamination, illustrated via Item Characteristic Curves (ICCs). \textbf  {Left}: global contamination produces no DIF; both cohorts encounter the item, and their ICCs overlap. \textbf  {Right}: differential contamination produces DIF; the focal cohort's ICC shifts because only that cohort was disproportionately exposed during training. The enrichment ratio of $\approx 1.0$ between DIF flags and web-overlap labels is expected because most MMLU items fall into the left category.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:global_vs_differential}{{1}{2}{Global vs.\ differential contamination, illustrated via Item Characteristic Curves (ICCs). \textbf {Left}: global contamination produces no DIF; both cohorts encounter the item, and their ICCs overlap. \textbf {Right}: differential contamination produces DIF; the focal cohort's ICC shifts because only that cohort was disproportionately exposed during training. The enrichment ratio of $\approx 1.0$ between DIF flags and web-overlap labels is expected because most MMLU items fall into the left category}{figure.caption.1}{}}
\newlabel{fig:global_vs_differential@cref}{{[figure][1][]1}{[1][2][]2}{}{}{}}
